---
import { Eye, Code } from '@lucide/astro';
import type { ProductDetail } from '@/types/models';
import { Image } from 'astro:assets';

interface Props {
  product: ProductDetail;
  iconComponent?: any;
}

const { product } = Astro.props;

// --- BILDER LOGIK (NEU) ---
// 1. Alle Produktbilder im Build-Prozess registrieren
const imageFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/products/**/*.{png,jpg,jpeg,webp}');

// 2. Pfade für dieses spezifische Produkt definieren
const imgPath1 = `/src/assets/products/${product.slug}/${product.slug}_1.png`;
const imgPath2 = `/src/assets/products/${product.slug}/${product.slug}_2.png`;
const imgPath3 = `/src/assets/products/${product.slug}/${product.slug}_3.png`;

// 3. Die korrekten Import-Funktionen aus der Map holen
const image1 = imageFiles[imgPath1];
const image2 = imageFiles[imgPath2];
const image3 = imageFiles[imgPath3];
// --------------------------

// Generate Schema.org structured data
const schemaProduct = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": product.name,
  "description": product.description,
  "brand": { "@type": "Brand", "name": "elmex" },
  "sku": product.sku,
  "offers": {
    "@type": "Offer",
    "price": product.price.toFixed(2),
    "priceCurrency": "EUR",
    "availability": product.availability
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": product.rating.value.toString(),
    "reviewCount": product.rating.count.toString()
  }
};
---

<div class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-neutral-200 py-4 transition-all">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-center gap-4">
      <div class="flex items-center gap-2 text-sm font-medium text-neutral-600">
        <Eye class="w-4 h-4" />
        <span>Human Focus</span>
      </div>

      <label class="relative inline-block w-16 h-8 cursor-pointer">
        <input type="checkbox" id="vision-switch" class="sr-only peer" />
        <div class="w-full h-full bg-gradient-to-r from-primary to-red-500 rounded-full peer-checked:from-gray-600 peer-checked:to-cyan-600 transition-all"></div>
        <div class="absolute top-1 left-1 w-6 h-6 bg-white rounded-full shadow-lg transition-all peer-checked:translate-x-8 flex items-center justify-center">
          <div class="w-2 h-2 bg-current rounded-full"></div>
        </div>
      </label>

      <div class="flex items-center gap-2 text-sm font-medium text-neutral-600">
        <Code class="w-4 h-4" />
        <span>Crawler Focus</span>
      </div>
    </div>
  </div>
</div>

<div id="human-mode" class="transition-all">
  <section class="bg-white py-12">
    <div class="container mx-auto px-4">
      <div class="mb-8">
        <h1 class="text-4xl md:text-5xl font-brand font-bold text-neutral-900 mb-2">
          {product.name}
        </h1>
        {product.subtitle && (
          <p class="text-xl text-neutral-600">{product.subtitle}</p>
        )}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <div class="md:col-span-2">
          <div class="relative aspect-[4/3] rounded-xl overflow-hidden bg-neutral-50 flex items-center justify-center">
            {image1 ? (
              <Image
                src={image1()}
                alt={`${product.name} - Hauptbild`}
                class="w-full h-full object-cover"
                width={800}
                height={600}
              />
            ) : (
              <span class="text-neutral-400">Bild nicht verfügbar</span>
            )}
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-1 gap-4">
          <div class="relative aspect-[4/3] rounded-xl overflow-hidden bg-neutral-50 flex items-center justify-center">
             {image2 ? (
              <Image
                src={image2()}
                alt={`${product.name} - Bild 2`}
                class="w-full h-full object-cover"
                width={400}
                height={300}
              />
            ) : (
              <span class="text-neutral-400 text-sm">Bild 2 fehlt</span>
            )}
          </div>
          <div class="relative aspect-[4/3] rounded-xl overflow-hidden bg-neutral-50 flex items-center justify-center">
            {image3 ? (
              <Image
                src={image3()}
                alt={`${product.name} - Bild 3`}
                class="w-full h-full object-cover"
                width={400}
                height={300}
              />
            ) : (
              <span class="text-neutral-400 text-sm">Bild 3 fehlt</span>
            )}
          </div>
        </div>
      </div>

      <div class="flex flex-wrap gap-3 mb-8">
        <a
          href={`/beratung/wo-kaufen?product=${product.slug}`}
          class="px-8 py-4 bg-primary hover:bg-primary-dark text-white font-semibold text-lg rounded-full transition-colors shadow-lg hover:shadow-xl"
        >
          Wo kaufen
        </a>
        <a
          href="#online-retailers"
          class="px-8 py-4 bg-white hover:bg-neutral-50 text-primary font-semibold text-lg rounded-full border-2 border-primary transition-colors"
        >
          Online kaufen
        </a>
        <button
          id="routine-btn"
          class="px-6 py-4 bg-neutral-100 hover:bg-neutral-200 text-neutral-700 font-medium rounded-full transition-colors"
        >
          <span id="routine-text">In Routine aufnehmen</span>
        </button>
        <button
          id="add-to-subscription"
          data-product-name={product.name}
          data-product-slug={product.slug}
          class="px-6 py-4 bg-neutral-100 hover:bg-neutral-200 text-neutral-700 font-medium rounded-full transition-colors"
        >
          Zu Abo hinzufügen
        </button>
      </div>

      <div class="mb-8">
        <p class="text-lg text-neutral-700 leading-relaxed mb-6">
          {product.description}
        </p>

        {product.badge && (
          <div class="inline-block px-4 py-2 bg-primary/10 text-primary rounded-full text-sm font-semibold">
            <span class="flex items-center gap-2">
              <div class="w-2 h-2 bg-primary rounded-full animate-pulse"></div>
              {product.badge.text}
            </span>
          </div>
        )}
      </div>

      {product.benefits && product.benefits.length > 0 && (
        <div class="mb-8">
          <h2 class="text-2xl font-brand font-bold text-neutral-900 mb-4">
            Vorteile
          </h2>
          <ul class="space-y-3">
            {product.benefits.map((benefit) => (
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-neutral-700">{benefit}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {product.matchingScore && (
        <div class="p-6 bg-gradient-to-r from-primary/5 to-orange-50 rounded-2xl border border-primary/20 mb-8">
          <div class="flex items-center justify-between mb-3">
            <h3 class="font-semibold text-neutral-900">Passt das zu mir?</h3>
            <div class="text-3xl font-bold gradient-title">{product.matchingScore.percentage}%</div>
          </div>
          <p class="text-sm text-neutral-600 mb-3">
            {product.matchingScore.profile}
          </p>
          {product.matchingScore.note && product.matchingScore.alternativeProduct && (
            <p class="text-xs text-neutral-500 flex items-start gap-2">
              <span class="text-orange-500">ⓘ</span>
              {product.matchingScore.note} <a href={product.matchingScore.alternativeProduct.url} class="text-primary hover:underline">{product.matchingScore.alternativeProduct.name}</a>
            </p>
          )}
        </div>
      )}

      <div id="online-retailers" class="mb-8">
        <h2 class="text-3xl font-brand font-bold text-neutral-900 mb-6">
          Online kaufen
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          <a
            href="https://www.dm.de"
            target="_blank"
            rel="noopener noreferrer"
            class="p-6 bg-white border-2 border-neutral-200 hover:border-primary rounded-xl transition-all hover:shadow-lg group"
          >
            <div class="flex flex-col items-center text-center">
              <div class="text-4xl font-bold text-neutral-800 mb-3">dm</div>
              <button class="mt-2 px-6 py-2 bg-primary text-white rounded-full group-hover:bg-primary-dark transition-colors text-sm font-medium">
                Jetzt kaufen
              </button>
            </div>
          </a>
          <a
            href="https://www.rossmann.de"
            target="_blank"
            rel="noopener noreferrer"
            class="p-6 bg-white border-2 border-neutral-200 hover:border-primary rounded-xl transition-all hover:shadow-lg group"
          >
            <div class="flex flex-col items-center text-center">
              <div class="text-4xl font-bold text-neutral-800 mb-3">Rossmann</div>
              <button class="mt-2 px-6 py-2 bg-primary text-white rounded-full group-hover:bg-primary-dark transition-colors text-sm font-medium">
                Jetzt kaufen
              </button>
            </div>
          </a>
          <a
            href="https://www.amazon.de"
            target="_blank"
            rel="noopener noreferrer"
            class="p-6 bg-white border-2 border-neutral-200 hover:border-primary rounded-xl transition-all hover:shadow-lg group"
          >
            <div class="flex flex-col items-center text-center">
              <div class="text-4xl font-bold text-neutral-800 mb-3">Amazon</div>
              <button class="mt-2 px-6 py-2 bg-primary text-white rounded-full group-hover:bg-primary-dark transition-colors text-sm font-medium">
                Jetzt kaufen
              </button>
            </div>
          </a>
          <a
            href="https://www.docmorris.de"
            target="_blank"
            rel="noopener noreferrer"
            class="p-6 bg-white border-2 border-neutral-200 hover:border-primary rounded-xl transition-all hover:shadow-lg group"
          >
            <div class="flex flex-col items-center text-center">
              <div class="text-4xl font-bold text-neutral-800 mb-3">DocMorris</div>
              <button class="mt-2 px-6 py-2 bg-primary text-white rounded-full group-hover:bg-primary-dark transition-colors text-sm font-medium">
                Jetzt kaufen
              </button>
            </div>
          </a>
        </div>
      </div>

      {product.ingredients && typeof product.ingredients === 'object' && 'active' in product.ingredients && (
        <section class="my-12">
          <h2 class="text-3xl font-brand font-bold text-neutral-900 mb-6">
            Inhaltsstoffe
          </h2>
          <div class="bg-neutral-50 rounded-xl p-6">
            <div class="mb-6">
              <h3 class="font-semibold text-lg text-neutral-800 mb-3">Wirkstoffe</h3>
              <ul class="space-y-2">
                {product.ingredients.active.map((ingredient: any) => (
                  <li class="flex items-start">
                    <span class="font-medium text-primary mr-2">•</span>
                    <div>
                      <span class="font-medium">{ingredient.name}</span>
                      <p class="text-sm text-neutral-600">{ingredient.description}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>

            <div>
              <h3 class="font-semibold text-lg text-neutral-800 mb-3">Weitere Inhaltsstoffe</h3>
              <p class="text-sm text-neutral-600 leading-relaxed">
                {product.ingredients.other}
              </p>
            </div>

            <p class="text-xs text-neutral-500 mt-4">
              Alle Angaben gemäß aktueller Rezeptur. Bei Fragen wenden Sie sich an Ihren Zahnarzt oder Apotheker.
            </p>
          </div>
        </section>
      )}
    </div>
  </section>

  <div id="subscription-modal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center">
    <div class="bg-white rounded-2xl p-8 max-w-md w-full mx-4 shadow-2xl">
      <h3 class="text-2xl font-brand font-bold text-neutral-900 mb-4">
        Zum Abo hinzufügen
      </h3>
      <p class="text-neutral-700 mb-6">
        <span id="modal-product-name" class="font-semibold"></span> wird zu Ihrer Abo-Liste hinzugefügt.
      </p>

      <div class="mb-6">
        <label class="block text-sm font-medium text-neutral-700 mb-2">
          Lieferintervall
        </label>
        <select id="interval-select" class="w-full px-4 py-3 rounded-lg border border-neutral-300 focus:ring-2 focus:ring-primary focus:border-primary">
          <option value="30">Alle 30 Tage</option>
          <option value="60">Alle 60 Tage</option>
          <option value="90">Alle 90 Tage</option>
        </select>
      </div>

      <div class="flex gap-3">
        <button id="confirm-subscription" class="flex-1 px-6 py-3 bg-primary hover:bg-primary-dark text-white font-semibold rounded-full transition-colors">
          Hinzufügen
        </button>
        <button id="cancel-subscription" class="px-6 py-3 bg-neutral-100 hover:bg-neutral-200 text-neutral-700 font-medium rounded-full transition-colors">
          Abbrechen
        </button>
      </div>
    </div>
  </div>

  <section class="py-24 bg-neutral-900 text-white relative overflow-hidden">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-brand font-bold mb-6 text-white">
          {product.howItWorks.title}
        </h2>
        <p class="text-xl text-neutral-300">
          {product.howItWorks.description}
        </p>
      </div>

      <div class="relative flex items-center justify-center">
        <div id="tooth-animation" class="relative w-full max-w-4xl">
          <div class="relative rounded-3xl overflow-hidden">
            <!-- Molar Detail Bild -->
            <img
              src="/models/molar_detail.png"
              alt="Zahnschmelz-Detailansicht - Wirkungsweise"
              class="w-full h-auto object-contain"
            />

            <!-- Wirkungsschritte als Overlay -->
            {product.howItWorks.steps.map((step, index) => (
              <div
                class={`absolute glass-dark p-4 rounded-xl animate-fade-in ${
                  index === 0 ? 'top-8 left-8' :
                  index === 1 ? 'bottom-8 right-8' :
                  index === 2 ? 'top-1/2 right-8 -translate-y-1/2' :
                  'bottom-8 left-8'
                }`}
                style={`animation-delay: ${index * 0.3}s`}
              >
                <p class="text-sm font-semibold mb-1">Schritt {step.number}</p>
                <p class="text-xs text-neutral-400">{step.title}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-4xl font-brand font-bold text-neutral-900 mb-6">
              {product.usage.title}
            </h2>
            <p class="text-lg text-neutral-600 mb-6">
              {product.usage.expert.description}
            </p>
            <div class="space-y-3">
              {product.usage.instructions.map((instruction) => (
                <div class="flex items-center gap-3">
                  <div class="w-6 h-6 bg-primary/10 rounded-full flex items-center justify-center">
                    <div class="w-2 h-2 bg-primary rounded-full"></div>
                  </div>
                  <span class="text-neutral-700">{instruction}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="relative aspect-video bg-neutral-900 rounded-2xl overflow-hidden shadow-2xl">
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="text-center">
                <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-4 hover:bg-white/30 transition-colors cursor-pointer">
                  <svg class="w-8 h-8 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
                <p class="text-white text-sm">Video abspielen</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<div id="crawler-mode" class="hidden transition-all">
  <div class="min-h-screen bg-neutral-900 text-white font-mono p-8">
    <div class="max-w-6xl mx-auto">

      <!-- Header -->
      <div class="mb-8 pb-4 border-b border-neutral-700">
        <h1 class="text-xl font-bold text-white mb-2">AI Crawler View</h1>
        <p class="text-neutral-400 text-sm">So sieht eine KI/Crawler diese Produktseite - optimiert für Generative Engine Optimization (GEO)</p>
      </div>

      <!-- Complete Product Page HTML -->
      <section class="mb-10">
        <h2 class="text-lg font-bold text-white mb-2">Produktseite HTML-Struktur</h2>
        <p class="text-neutral-400 text-sm mb-4">Der vollständige Code dieser Produktseite mit JSON-LD Schema und semantischem HTML</p>
        <div class="bg-neutral-950 rounded-xl overflow-hidden border border-neutral-800">
          <div class="flex items-center gap-2 px-4 py-2 bg-neutral-800 border-b border-neutral-700">
            <div class="w-3 h-3 rounded-full bg-red-500"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
            <div class="w-3 h-3 rounded-full bg-green-500"></div>
            <span class="text-neutral-400 text-xs ml-2">produkte/{product.slug}.html</span>
          </div>
          <pre class="p-5 text-sm overflow-x-auto leading-relaxed"><code class="text-white"><span class="text-neutral-500">&lt;!-- JSON-LD Structured Data --&gt;</span>
<span class="text-red-400">&lt;script</span> <span class="text-orange-300">type</span>=<span class="text-green-300">"application/ld+json"</span><span class="text-red-400">&gt;</span>
{`{`}
  <span class="text-blue-300">"@context"</span>: <span class="text-green-300">"https://schema.org/"</span>,
  <span class="text-blue-300">"@type"</span>: <span class="text-green-300">"Product"</span>,
  <span class="text-blue-300">"name"</span>: <span class="text-green-300">"{product.name}"</span>,
  <span class="text-blue-300">"description"</span>: <span class="text-green-300">"{product.description}"</span>,
  <span class="text-blue-300">"brand"</span>: {`{`}
    <span class="text-blue-300">"@type"</span>: <span class="text-green-300">"Brand"</span>,
    <span class="text-blue-300">"name"</span>: <span class="text-green-300">"elmex"</span>
  {`}`},
  <span class="text-blue-300">"sku"</span>: <span class="text-green-300">"{product.sku}"</span>,
  <span class="text-blue-300">"offers"</span>: {`{`}
    <span class="text-blue-300">"@type"</span>: <span class="text-green-300">"Offer"</span>,
    <span class="text-blue-300">"price"</span>: <span class="text-yellow-200">{product.price.toFixed(2)}</span>,
    <span class="text-blue-300">"priceCurrency"</span>: <span class="text-green-300">"EUR"</span>,
    <span class="text-blue-300">"availability"</span>: <span class="text-green-300">"{product.availability}"</span>
  {`}`},
  <span class="text-blue-300">"aggregateRating"</span>: {`{`}
    <span class="text-blue-300">"@type"</span>: <span class="text-green-300">"AggregateRating"</span>,
    <span class="text-blue-300">"ratingValue"</span>: <span class="text-yellow-200">{product.rating.value}</span>,
    <span class="text-blue-300">"reviewCount"</span>: <span class="text-yellow-200">{product.rating.count}</span>
  {`}`}
{`}`}
<span class="text-red-400">&lt;/script&gt;</span>

<span class="text-neutral-500">&lt;!-- Semantic HTML5 Structure --&gt;</span>
<span class="text-red-400">&lt;article</span> <span class="text-orange-300">itemscope</span> <span class="text-orange-300">itemtype</span>=<span class="text-green-300">"https://schema.org/Product"</span><span class="text-red-400">&gt;</span>

  <span class="text-neutral-500">&lt;!-- Product Header --&gt;</span>
  <span class="text-red-400">&lt;header&gt;</span>
    <span class="text-red-400">&lt;h1</span> <span class="text-orange-300">itemprop</span>=<span class="text-green-300">"name"</span><span class="text-red-400">&gt;</span><span class="text-white">{product.name}</span><span class="text-red-400">&lt;/h1&gt;</span>
    {product.subtitle && <><span class="text-red-400">&lt;p</span> <span class="text-orange-300">itemprop</span>=<span class="text-green-300">"alternateName"</span><span class="text-red-400">&gt;</span><span class="text-white">{product.subtitle}</span><span class="text-red-400">&lt;/p&gt;</span></>}
  <span class="text-red-400">&lt;/header&gt;</span>

  <span class="text-neutral-500">&lt;!-- Product Description --&gt;</span>
  <span class="text-red-400">&lt;section</span> <span class="text-orange-300">itemprop</span>=<span class="text-green-300">"description"</span><span class="text-red-400">&gt;</span>
    <span class="text-white">{product.description}</span>
  <span class="text-red-400">&lt;/section&gt;</span>

  <span class="text-neutral-500">&lt;!-- Brand Entity --&gt;</span>
  <span class="text-red-400">&lt;div</span> <span class="text-orange-300">itemprop</span>=<span class="text-green-300">"brand"</span> <span class="text-orange-300">itemscope</span> <span class="text-orange-300">itemtype</span>=<span class="text-green-300">"https://schema.org/Brand"</span><span class="text-red-400">&gt;</span>
    <span class="text-red-400">&lt;meta</span> <span class="text-orange-300">itemprop</span>=<span class="text-green-300">"name"</span> <span class="text-orange-300">content</span>=<span class="text-green-300">"elmex"</span> <span class="text-red-400">/&gt;</span>
  <span class="text-red-400">&lt;/div&gt;</span>

  <span class="text-neutral-500">&lt;!-- Price and Availability --&gt;</span>
  <span class="text-red-400">&lt;div</span> <span class="text-orange-300">itemprop</span>=<span class="text-green-300">"offers"</span> <span class="text-orange-300">itemscope</span> <span class="text-orange-300">itemtype</span>=<span class="text-green-300">"https://schema.org/Offer"</span><span class="text-red-400">&gt;</span>
    <span class="text-red-400">&lt;meta</span> <span class="text-orange-300">itemprop</span>=<span class="text-green-300">"price"</span> <span class="text-orange-300">content</span>=<span class="text-green-300">"{product.price.toFixed(2)}"</span> <span class="text-red-400">/&gt;</span>
    <span class="text-red-400">&lt;meta</span> <span class="text-orange-300">itemprop</span>=<span class="text-green-300">"priceCurrency"</span> <span class="text-orange-300">content</span>=<span class="text-green-300">"EUR"</span> <span class="text-red-400">/&gt;</span>
    <span class="text-red-400">&lt;link</span> <span class="text-orange-300">itemprop</span>=<span class="text-green-300">"availability"</span> <span class="text-orange-300">href</span>=<span class="text-green-300">"{product.availability}"</span> <span class="text-red-400">/&gt;</span>
  <span class="text-red-400">&lt;/div&gt;</span>

  <span class="text-neutral-500">&lt;!-- Rating --&gt;</span>
  <span class="text-red-400">&lt;div</span> <span class="text-orange-300">itemprop</span>=<span class="text-green-300">"aggregateRating"</span> <span class="text-orange-300">itemscope</span> <span class="text-orange-300">itemtype</span>=<span class="text-green-300">"https://schema.org/AggregateRating"</span><span class="text-red-400">&gt;</span>
    <span class="text-red-400">&lt;meta</span> <span class="text-orange-300">itemprop</span>=<span class="text-green-300">"ratingValue"</span> <span class="text-orange-300">content</span>=<span class="text-green-300">"{product.rating.value}"</span> <span class="text-red-400">/&gt;</span>
    <span class="text-red-400">&lt;meta</span> <span class="text-orange-300">itemprop</span>=<span class="text-green-300">"reviewCount"</span> <span class="text-orange-300">content</span>=<span class="text-green-300">"{product.rating.count}"</span> <span class="text-red-400">/&gt;</span>
  <span class="text-red-400">&lt;/div&gt;</span>

  <span class="text-neutral-500">&lt;!-- Product Benefits --&gt;</span>
  {product.benefits && product.benefits.length > 0 && (<>
  <span class="text-red-400">&lt;section</span> <span class="text-orange-300">aria-labelledby</span>=<span class="text-green-300">"benefits"</span><span class="text-red-400">&gt;</span>
    <span class="text-red-400">&lt;h2</span> <span class="text-orange-300">id</span>=<span class="text-green-300">"benefits"</span><span class="text-red-400">&gt;</span><span class="text-white">Vorteile</span><span class="text-red-400">&lt;/h2&gt;</span>
    <span class="text-red-400">&lt;ul&gt;</span>
{product.benefits.map((benefit) => (
      <span class="text-red-400">&lt;li&gt;</span><span class="text-white">{benefit}</span><span class="text-red-400">&lt;/li&gt;</span>
))}
    <span class="text-red-400">&lt;/ul&gt;</span>
  <span class="text-red-400">&lt;/section&gt;</span>
  </>)}

  <span class="text-neutral-500">&lt;!-- Ingredients --&gt;</span>
  {product.ingredients && typeof product.ingredients === 'object' && 'active' in product.ingredients && (<>
  <span class="text-red-400">&lt;section</span> <span class="text-orange-300">aria-labelledby</span>=<span class="text-green-300">"ingredients"</span><span class="text-red-400">&gt;</span>
    <span class="text-red-400">&lt;h2</span> <span class="text-orange-300">id</span>=<span class="text-green-300">"ingredients"</span><span class="text-red-400">&gt;</span><span class="text-white">Inhaltsstoffe</span><span class="text-red-400">&lt;/h2&gt;</span>
    <span class="text-red-400">&lt;h3&gt;</span><span class="text-white">Wirkstoffe</span><span class="text-red-400">&lt;/h3&gt;</span>
    <span class="text-red-400">&lt;ul&gt;</span>
{product.ingredients.active.map((ingredient: any) => (
      <span class="text-red-400">&lt;li&gt;</span><span class="text-red-400">&lt;strong&gt;</span><span class="text-white">{ingredient.name}</span><span class="text-red-400">&lt;/strong&gt;</span><span class="text-white">{ingredient.description}</span><span class="text-red-400">&lt;/li&gt;</span>
))}
    <span class="text-red-400">&lt;/ul&gt;</span>
    <span class="text-red-400">&lt;p&gt;</span><span class="text-white">{product.ingredients.other}</span><span class="text-red-400">&lt;/p&gt;</span>
  <span class="text-red-400">&lt;/section&gt;</span>
  </>)}

<span class="text-red-400">&lt;/article&gt;</span></code></pre>
        </div>
      </section>

      <!-- Extracted Data Summary -->
      <section class="mb-10">
        <h2 class="text-lg font-bold text-white mb-2">Extrahierte Produktdaten</h2>
        <p class="text-neutral-400 text-sm mb-4">Diese Daten kann eine KI aus der Seite extrahieren und zitieren</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
