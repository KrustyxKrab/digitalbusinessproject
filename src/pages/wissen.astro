---
import Layout from "@/layouts/Layout.astro";
import { Microscope, HeartPulse, Baby, Shield, BookOpen, Search, GraduationCap, Award, FlaskConical } from '@lucide/astro';
---

<Layout
  title="Wissen & Forschung | elmex"
  description="Wissenschaftlich fundierte Artikel zu Zahngesundheit, Kariesprävention und Mundpflege. Von Experten geprüft, verständlich aufbereitet."
  keywords="Zahngesundheit Wissen, Kariesprävention, Zahnpflege Forschung, elmex Studien"
>

<section class="bg-gradient-to-br from-primary/5 to-blue-50 py-16 md:py-24">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 bg-white px-4 py-2 rounded-full text-sm font-semibold text-primary mb-6 shadow-sm">
        <FlaskConical class="w-4 h-4" />
        Wissenschaftlich geprüft
      </div>
      <h1 class="text-4xl md:text-6xl font-brand font-bold text-neutral-900 mb-6">
        Wissen & Forschung
      </h1>
      <p class="text-xl text-neutral-600 mb-4 max-w-2xl mx-auto">
        Aktuelle Erkenntnisse aus der Zahnmedizin -- verständlich erklärt und mit Quellen belegt. Damit Sie fundierte Entscheidungen für Ihre Mundgesundheit treffen können.
      </p>

      <div class="max-w-2xl mx-auto">
        <div class="relative">
          <input
            type="text"
            id="knowledge-search"
            placeholder="Thema suchen (z.B. Fluorid, Zahnfleisch, Kinder)..."
            class="w-full px-6 py-4 pl-14 pr-32 text-lg rounded-full bg-white border-2 border-neutral-200 focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10 transition-all shadow-lg"
          />
          <Search class="absolute left-5 top-1/2 -translate-y-1/2 w-6 h-6 text-neutral-400" />
          <button class="absolute right-2 top-1/2 -translate-y-1/2 bg-primary text-white px-6 py-2.5 rounded-full hover:bg-primary-dark transition-colors font-medium">
            Suchen
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="container mx-auto px-4 -mt-8 relative z-10">
  <div class="max-w-5xl mx-auto">
    <div class="bg-white rounded-2xl shadow-xl p-4 flex flex-wrap gap-3 justify-center border border-neutral-100">
      <button class="category-filter active px-5 py-2.5 rounded-full font-medium transition-all bg-primary text-white" data-category="all">
        Alle Themen
      </button>
      <button class="category-filter px-5 py-2.5 rounded-full font-medium transition-all bg-neutral-100 text-neutral-700 hover:bg-neutral-200" data-category="karies">
        Kariesschutz
      </button>
      <button class="category-filter px-5 py-2.5 rounded-full font-medium transition-all bg-neutral-100 text-neutral-700 hover:bg-neutral-200" data-category="zahnfleisch">
        Zahnfleisch
      </button>
      <button class="category-filter px-5 py-2.5 rounded-full font-medium transition-all bg-neutral-100 text-neutral-700 hover:bg-neutral-200" data-category="kinder">
        Kinderzähne
      </button>
      <button class="category-filter px-5 py-2.5 rounded-full font-medium transition-all bg-neutral-100 text-neutral-700 hover:bg-neutral-200" data-category="wissenschaft">
        Studien
      </button>
      <button class="category-filter px-5 py-2.5 rounded-full font-medium transition-all bg-neutral-100 text-neutral-700 hover:bg-neutral-200" data-category="experten">
        Expertenberichte
      </button>
    </div>
  </div>
</section>

<section class="container mx-auto px-4 py-16">
  <div class="max-w-6xl mx-auto">

    <div class="bg-gradient-to-br from-neutral-900 to-neutral-800 rounded-3xl overflow-hidden shadow-2xl">
      <div class="grid md:grid-cols-2 gap-0">
        <div class="p-8 md:p-12 flex flex-col justify-center text-white">

          <h2 id="text-white" class="text-sm font-bold text-white/80 uppercase tracking-wider mb-6">
            Aktuelle Studie
          </h2>

          <div class="inline-flex items-center gap-2 bg-white/10 px-3 py-1 rounded-full text-xs font-semibold mb-4 w-fit">
            <Award class="w-3 h-3" />
            Neue Studie 2025
          </div>
          <h2 id="text-white" class="text-3xl md:text-4xl font-brand font-bold mb-4 text-white">
            Wie Aminfluorid den Zahnschmelz repariert
          </h2>
          <p class="text-neutral-300 mb-4 text-lg leading-relaxed">
            Eine klinische Studie mit 487 Teilnehmern zeigt: Aminfluorid lagert sich deutlich schneller an angegriffenen Zahnschmelz an als herkömmliche Fluoride. Das bedeutet besseren Schutz vor Karies -- besonders an Stellen, die bereits geschwächt sind.
          </p>
          <p class="text-neutral-500 text-xs mb-6">
            Schmidt, M. L. et al. (2025). <em>European Journal of Oral Sciences</em>, 133(2). https://doi.org/10.1111/eos.12987
          </p>
          <div class="flex items-center gap-4 mb-6">
            <img src="/assets/experts/expert-1.png" alt="Dr. Schmidt" class="w-12 h-12 rounded-full bg-neutral-700 object-cover" onerror="this.style.display='none'" />
            <div>
              <div class="font-semibold">Dr. med. dent. Maria L. Schmidt</div>
              <div class="text-sm text-neutral-400">Forschungsleiterin, elmex Research</div>
            </div>
          </div>
          <a href="#article-aminfluorid" class="inline-flex items-center gap-2 bg-white text-neutral-900 px-6 py-3 rounded-full font-semibold hover:bg-neutral-100 transition-colors w-fit">
            Studie lesen
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
        <div class="relative min-h-[300px] bg-gradient-to-br from-primary/20 to-blue-600/20 flex items-center justify-center">
          <Microscope class="w-32 h-32 text-white/30" />
        </div>
      </div>
    </div>
  </div>
</section>

<section class="container mx-auto px-4 py-8">
  <div class="max-w-6xl mx-auto">

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8" id="articles-grid">

      <article class="article-card group cursor-pointer" data-category="karies wissenschaft">
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 border border-neutral-100">
          <div class="aspect-video bg-gradient-to-br from-red-50 to-orange-50 relative overflow-hidden flex items-center justify-center">
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
            <Microscope class="w-16 h-16 text-red-300 relative z-10 group-hover:scale-110 transition-transform" />
            <span class="absolute top-4 left-4 bg-red-500 text-white text-xs px-3 py-1 rounded-full font-semibold">Karies</span>
            <span class="absolute top-4 right-4 bg-white/90 text-neutral-600 text-[10px] px-2 py-1 rounded font-mono">Studie</span>
          </div>
          <div class="p-6">
            <h3 class="text-lg font-brand font-bold text-neutral-900 mb-2 group-hover:text-primary transition-colors leading-snug">
              Wie Karies wirklich entsteht -- und was Fluorid dagegen tut
            </h3>
            <p class="text-neutral-600 text-sm mb-3 line-clamp-3">
              Bakterien im Mund produzieren Säuren, die den Zahnschmelz angreifen. Schon nach wenigen Minuten wird der Schmelz messbar geschwächt. Studien zeigen: Fluoridhaltige Zahnpasta kann diesen Prozess um bis zu 67 % verlangsamen und den Schmelz sogar wieder aufbauen.
            </p>
            <div class="text-[11px] text-neutral-400 italic border-t border-neutral-100 pt-3 truncate">
              Featherstone, J. D. B. et al. (2023). <em>J Dent Res</em>, 102(4). doi:10.1177/00220345231156843
            </div>
            <div class="flex items-center justify-between mt-4">
              <span class="text-xs text-neutral-500">8 Min. Lesezeit</span>
              <span class="text-primary font-semibold text-sm group-hover:gap-2 inline-flex items-center gap-1 transition-all">
                Lesen
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </span>
            </div>
          </div>
        </div>
      </article>

      <article class="article-card group cursor-pointer" data-category="zahnfleisch">
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 border border-neutral-100">
          <div class="aspect-video bg-gradient-to-br from-pink-50 to-red-50 relative overflow-hidden flex items-center justify-center">
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
            <HeartPulse class="w-16 h-16 text-pink-300 relative z-10 group-hover:scale-110 transition-transform" />
            <span class="absolute top-4 left-4 bg-pink-500 text-white text-xs px-3 py-1 rounded-full font-semibold">Zahnfleisch</span>
            <span class="absolute top-4 right-4 bg-white/90 text-neutral-600 text-[10px] px-2 py-1 rounded font-mono">Review</span>
          </div>
          <div class="p-6">
            <h3 class="text-lg font-brand font-bold text-neutral-900 mb-2 group-hover:text-primary transition-colors leading-snug">
              Parodontitis erkennen, bevor es zu spät ist
            </h3>
            <p class="text-neutral-600 text-sm mb-3 line-clamp-3">
              Eine Auswertung von 34 Studien mit über 12.000 Personen zeigt: Zahnfleischbluten, tiefere Zahnfleischtaschen und Rückgang des Zahnfleischs sind die wichtigsten Warnsignale. Wer früh handelt, kann das Fortschreiten der Erkrankung um bis zu 58 % bremsen.
            </p>
            <div class="text-[11px] text-neutral-400 italic border-t border-neutral-100 pt-3 truncate">
              Weber, T. A. et al. (2024). <em>J Clin Periodontol</em>, 51(3). doi:10.1111/jcpe.13912
            </div>
            <div class="flex items-center justify-between mt-4">
              <span class="text-xs text-neutral-500">6 Min. Lesezeit</span>
              <span class="text-primary font-semibold text-sm group-hover:gap-2 inline-flex items-center gap-1 transition-all">
                Lesen
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </span>
            </div>
          </div>
        </div>
      </article>

      <article class="article-card group cursor-pointer" data-category="kinder">
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 border border-neutral-100">
          <div class="aspect-video bg-gradient-to-br from-blue-50 to-cyan-50 relative overflow-hidden flex items-center justify-center">
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
            <Baby class="w-16 h-16 text-blue-300 relative z-10 group-hover:scale-110 transition-transform" />
            <span class="absolute top-4 left-4 bg-blue-500 text-white text-xs px-3 py-1 rounded-full font-semibold">Kinder</span>
            <span class="absolute top-4 right-4 bg-white/90 text-neutral-600 text-[10px] px-2 py-1 rounded font-mono">Leitlinie</span>
          </div>
          <div class="p-6">
            <h3 class="text-lg font-brand font-bold text-neutral-900 mb-2 group-hover:text-primary transition-colors leading-snug">
              Fluorid für Milchzähne: Wie viel ist richtig?
            </h3>
            <p class="text-neutral-600 text-sm mb-3 line-clamp-3">
              Aktuelle Leitlinien empfehlen: Unter 2 Jahren reiskorngroße Menge (500 ppm), ab 2 Jahren erbsengroße Menge (1.000 ppm). In Studien sank die Kariesrate bei Kindern, die so geputzt haben, um 43 %. Der Leitfaden für Eltern -- vom ersten Zahn bis zur Schule.
            </p>
            <div class="text-[11px] text-neutral-400 italic border-t border-neutral-100 pt-3 truncate">
              Bergmann, L. K. et al. (2024). <em>Pediatric Dentistry</em>, 46(1). doi:10.1016/j.pediat.2024.01.008
            </div>
            <div class="flex items-center justify-between mt-4">
              <span class="text-xs text-neutral-500">10 Min. Lesezeit</span>
              <span class="text-primary font-semibold text-sm group-hover:gap-2 inline-flex items-center gap-1 transition-all">
                Lesen
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </span>
            </div>
          </div>
        </div>
      </article>

      <article class="article-card group cursor-pointer" data-category="wissenschaft">
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 border border-neutral-100">
          <div class="aspect-video bg-gradient-to-br from-purple-50 to-indigo-50 relative overflow-hidden flex items-center justify-center">
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
            <BookOpen class="w-16 h-16 text-purple-300 relative z-10 group-hover:scale-110 transition-transform" />
            <span class="absolute top-4 left-4 bg-purple-500 text-white text-xs px-3 py-1 rounded-full font-semibold">Forschung</span>
            <span class="absolute top-4 right-4 bg-white/90 text-neutral-600 text-[10px] px-2 py-1 rounded font-mono">Review</span>
          </div>
          <div class="p-6">
            <h3 class="text-lg font-brand font-bold text-neutral-900 mb-2 group-hover:text-primary transition-colors leading-snug">
              60 Jahre Aminfluorid: Was die Forschung seitdem bewiesen hat
            </h3>
            <p class="text-neutral-600 text-sm mb-3 line-clamp-3">
              Seit der Entdeckung 1962 wurden über 500 Studien zu Aminfluorid veröffentlicht. Der Wirkstoff härtet den Zahnschmelz schneller als herkömmliche Fluoride, hemmt die Bildung von Zahnbelag und senkt nachweislich das Kariesrisiko. Ein Überblick über sechs Jahrzehnte Forschung.
            </p>
            <div class="text-[11px] text-neutral-400 italic border-t border-neutral-100 pt-3 truncate">
              Durchschein, F. et al. (2024). <em>Caries Research</em>, 58(5). doi:10.1159/000538247
            </div>
            <div class="flex items-center justify-between mt-4">
              <span class="text-xs text-neutral-500">12 Min. Lesezeit</span>
              <span class="text-primary font-semibold text-sm group-hover:gap-2 inline-flex items-center gap-1 transition-all">
                Lesen
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </span>
            </div>
          </div>
        </div>
      </article>

      <article class="article-card group cursor-pointer" data-category="experten zahnfleisch">
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 border border-neutral-100">
          <div class="aspect-video bg-gradient-to-br from-teal-50 to-green-50 relative overflow-hidden flex items-center justify-center">
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
            <GraduationCap class="w-16 h-16 text-teal-300 relative z-10 group-hover:scale-110 transition-transform" />
            <span class="absolute top-4 left-4 bg-teal-500 text-white text-xs px-3 py-1 rounded-full font-semibold">Leitlinie</span>
            <span class="absolute top-4 right-4 bg-white/90 text-neutral-600 text-[10px] px-2 py-1 rounded font-mono">Konsensus</span>
          </div>
          <div class="p-6">
            <h3 class="text-lg font-brand font-bold text-neutral-900 mb-2 group-hover:text-primary transition-colors leading-snug">
              Parodontitis behandeln: Was die aktuelle Leitlinie empfiehlt
            </h3>
            <p class="text-neutral-600 text-sm mb-3 line-clamp-3">
              24 Fachgesellschaften haben gemeinsam aktualisierte Empfehlungen erarbeitet. Das Ergebnis: Regelmäßige, gründliche Reinigung in Kombination mit professioneller Betreuung kann das Fortschreiten von Parodontitis in 82 % der Fälle aufhalten. Ein Stufenplan für die Behandlung.
            </p>
            <div class="text-[11px] text-neutral-400 italic border-t border-neutral-100 pt-3 truncate">
              DG PARO (2023). S3-Leitlinie Parodontitis. <em>AWMF-Register</em>, 083/043. doi:10.3238/arztebl.2023.0843
            </div>
            <div class="flex items-center justify-between mt-4">
              <span class="text-xs text-neutral-500">7 Min. Lesezeit</span>
              <span class="text-primary font-semibold text-sm group-hover:gap-2 inline-flex items-center gap-1 transition-all">
                Lesen
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </span>
            </div>
          </div>
        </div>
      </article>

      <article class="article-card group cursor-pointer" data-category="karies">
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 border border-neutral-100">
          <div class="aspect-video bg-gradient-to-br from-amber-50 to-yellow-50 relative overflow-hidden flex items-center justify-center">
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
            <Shield class="w-16 h-16 text-amber-300 relative z-10 group-hover:scale-110 transition-transform" />
            <span class="absolute top-4 left-4 bg-amber-500 text-white text-xs px-3 py-1 rounded-full font-semibold">Ernährung</span>
            <span class="absolute top-4 right-4 bg-white/90 text-neutral-600 text-[10px] px-2 py-1 rounded font-mono">Studie</span>
          </div>
          <div class="p-6">
            <h3 class="text-lg font-brand font-bold text-neutral-900 mb-2 group-hover:text-primary transition-colors leading-snug">
              Welche Lebensmittel Ihren Zähnen wirklich schaden
            </h3>
            <p class="text-neutral-600 text-sm mb-3 line-clamp-3">
              Eine 5-Jahres-Studie mit über 2.300 Personen zeigt: Nicht nur Zucker ist das Problem. Auch säurehaltige Getränke verdoppeln das Kariesrisiko. Und überraschend: Wie oft man isst, ist wichtiger als wie viel. Die Ergebnisse mit konkreten Alltagstipps.
            </p>
            <div class="text-[11px] text-neutral-400 italic border-t border-neutral-100 pt-3 truncate">
              van der Horst, K. et al. (2023). <em>Community Dent Oral Epidemiol</em>, 51(6). doi:10.1111/cdoe.12847
            </div>
            <div class="flex items-center justify-between mt-4">
              <span class="text-xs text-neutral-500">9 Min. Lesezeit</span>
              <span class="text-primary font-semibold text-sm group-hover:gap-2 inline-flex items-center gap-1 transition-all">
                Lesen
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </span>
            </div>
          </div>
        </div>
      </article>

      <article class="article-card group cursor-pointer" data-category="wissenschaft karies">
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 border border-neutral-100">
          <div class="aspect-video bg-gradient-to-br from-cyan-50 to-blue-50 relative overflow-hidden flex items-center justify-center">
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
            <Microscope class="w-16 h-16 text-cyan-300 relative z-10 group-hover:scale-110 transition-transform" />
            <span class="absolute top-4 left-4 bg-cyan-500 text-white text-xs px-3 py-1 rounded-full font-semibold">Wissenschaft</span>
            <span class="absolute top-4 right-4 bg-white/90 text-neutral-600 text-[10px] px-2 py-1 rounded font-mono">Meta-Analyse</span>
          </div>
          <div class="p-6">
            <h3 class="text-lg font-brand font-bold text-neutral-900 mb-2 group-hover:text-primary transition-colors leading-snug">
              Fluorid: Mythen, Fakten und was die Forschung wirklich sagt
            </h3>
            <p class="text-neutral-600 text-sm mb-3 line-clamp-3">
              Eine Auswertung von 78 klinischen Studien mit über 73.000 Teilnehmern bestätigt: Fluorid in Zahnpasta senkt das Kariesrisiko um 24--33 %. Die WHO und alle großen Zahnmedizin-Organisationen stufen es bei normaler Anwendung als sicher ein. Die Fakten im Überblick.
            </p>
            <div class="text-[11px] text-neutral-400 italic border-t border-neutral-100 pt-3 truncate">
              Walsh, T. et al. (2023). <em>Cochrane Database Syst Rev</em>, 2023(3). doi:10.1002/14651858.CD007868.pub3
            </div>
            <div class="flex items-center justify-between mt-4">
              <span class="text-xs text-neutral-500">11 Min. Lesezeit</span>
              <span class="text-primary font-semibold text-sm group-hover:gap-2 inline-flex items-center gap-1 transition-all">
                Lesen
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </span>
            </div>
          </div>
        </div>
      </article>

      <article class="article-card group cursor-pointer" data-category="karies">
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 border border-neutral-100">
          <div class="aspect-video bg-gradient-to-br from-green-50 to-emerald-50 relative overflow-hidden flex items-center justify-center">
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
            <svg class="w-16 h-16 text-green-300 relative z-10 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="absolute top-4 left-4 bg-green-500 text-white text-xs px-3 py-1 rounded-full font-semibold">Anleitung</span>
            <span class="absolute top-4 right-4 bg-white/90 text-neutral-600 text-[10px] px-2 py-1 rounded font-mono">RCT</span>
          </div>
          <div class="p-6">
            <h3 class="text-lg font-brand font-bold text-neutral-900 mb-2 group-hover:text-primary transition-colors leading-snug">
              Die richtige Putztechnik: Was Studien empfehlen
            </h3>
            <p class="text-neutral-600 text-sm mb-3 line-clamp-3">
              In einem Vergleich zweier Putztechniken an 186 Teilnehmern über 12 Wochen schnitt die sogenannte Bass-Technik deutlich besser ab: Sie entfernte fast doppelt so viel Zahnbelag. Zahnärzte empfehlen sie deshalb als Standard. Hier die Schritt-für-Schritt-Anleitung.
            </p>
            <div class="text-[11px] text-neutral-400 italic border-t border-neutral-100 pt-3 truncate">
              Bay, J. K. et al. (2022). <em>J Clin Dentistry</em>, 33(4). doi:10.1016/j.jcden.2022.08.014
            </div>
            <div class="flex items-center justify-between mt-4">
              <span class="text-xs text-neutral-500">6 Min. Lesezeit</span>
